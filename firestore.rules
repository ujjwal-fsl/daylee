rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents: only the authenticated owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Notebook subcollection: strictly per-user access
      match /notebook/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
